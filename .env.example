# ─────────────────────────────────────────────────────────────────────────────
# Orbix Declare — front-end
# Copie para .env.local e preencha. Tudo aqui é PÚBLICO (vai para o navegador).
# NUNCA coloque segredos do back-end aqui (Helius, Anthropic, Supabase service role, R2...).
# ─────────────────────────────────────────────────────────────────────────────

# URL base da API do back-end (sem barra no final). Ex.: https://api.orbixdeclare.com
# Vazia = modo demonstração (dados de exemplo, sem back-end).
NEXT_PUBLIC_API_URL=

# Força o modo demonstração mesmo com NEXT_PUBLIC_API_URL preenchida (true/false).
NEXT_PUBLIC_USE_MOCKS=false

# Rede Solana usada nos links do Solana Explorer: mainnet-beta | devnet | testnet
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta

# RPC Solana usado pelo Wallet Adapter (o front não envia transações; só assina mensagem no login).
# Use um RPC público ou um endpoint SEM chave secreta na URL.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# URL pública do app, usada no link de verificação (/v/<id>). Vazia = domínio da própria página.
NEXT_PUBLIC_APP_URL=
